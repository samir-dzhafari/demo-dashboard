{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/app": ["./src/app"],
      "@/app/*": ["./src/app/*"],
      "@/pages": ["./src/pages"],
      "@/pages/*": ["./src/pages/*"],
      "@/widgets": ["./src/widgets"],
      "@/widgets/*": ["./src/widgets/*"],
      "@/features": ["./src/features"],
      "@/features/*": ["./src/features/*"],
      "@/entities": ["./src/entities"],
      "@/entities/*": ["./src/entities/*"],
      "@/shared": ["./src/shared"],
      "@/shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts", "eslint.config.js"]
}
